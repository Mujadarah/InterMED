# Optional. No .env file is needed. VITE_RUNTIME_MODE=mock is the only mode.
VITE_RUNTIME_MODE=mock

# Optional public identifiers of the future published-dataset reader. They are
# not secrets, are ignored in mock mode and must all be set together. Keep them
# commented out until a maintainer authorizes a backend connection.
# VITE_PUBLISHED_DATASETS_ENDPOINT=https://fra.cloud.appwrite.io/v1
# VITE_APPWRITE_PROJECT_ID=intermed-dev
# VITE_APPWRITE_PUBLISHED_BUCKET_ID=published-datasets
